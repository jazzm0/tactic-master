<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- Full-width filter bar at the top -->
    <LinearLayout
        android:id="@+id/filter_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/filter_dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/outlined_box_background"
            android:enabled="false"
            android:inputType="none"
            android:maxWidth="480dp"
            android:text="" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filter_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/filter"
            app:icon="@drawable/ic_filter" />

    </LinearLayout>

    <!-- Chessboard: left half, square, bounded top/bottom -->
    <com.tacticmaster.board.ChessboardView
        android:id="@+id/chessboard_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/right_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_container" />

    <!-- Hint overlay mirrors the board exactly -->
    <com.tacticmaster.board.PuzzleHintView
        android:id="@+id/hint_path_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/chessboard_view"
        app:layout_constraintEnd_toEndOf="@id/chessboard_view"
        app:layout_constraintStart_toStartOf="@id/chessboard_view"
        app:layout_constraintTop_toTopOf="@id/chessboard_view" />

    <!-- Right panel: all controls/info -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/right_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/chessboard_view"
        app:layout_constraintTop_toBottomOf="@id/filter_container">

        <!-- Settings button: top-end corner -->
        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            android:background="@color/button_background_color"
            android:contentDescription="@string/settings_title"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header: player rating + turn icon -->
        <LinearLayout
            android:id="@+id/header_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:layout_constraintEnd_toStartOf="@id/settings_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="UseCompoundDrawables">

            <TextView
                android:id="@+id/player_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="@string/player_rating"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/player_turn_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/player_turn"
                android:src="@drawable/ic_white_turn" />

        </LinearLayout>

        <!-- Info: puzzle rating, ID, solved count -->
        <LinearLayout
            android:id="@+id/info_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/button_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_container">

            <TextView
                android:id="@+id/puzzle_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/rating"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/puzzle_id_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/puzzle_id_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/puzzle_id"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/puzzle_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:autofillHints="name"
                    android:gravity="center"
                    android:hint="@string/puzzle_id_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions"
                    android:maxLength="5"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/puzzle_id_link"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/puzzle_id_sharing"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_link" />

                <ImageButton
                    android:id="@+id/share_fen_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/share_fen"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_share" />
            </LinearLayout>

            <TextView
                android:id="@+id/puzzles_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/puzzles_solved"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Prev/Next navigation -->
        <LinearLayout
            android:id="@+id/button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/hint_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageButton
                android:id="@+id/previous_puzzle"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:background="@color/button_background_color"
                android:contentDescription="@string/show_previous_puzzle"
                android:scaleType="centerInside"
                android:src="@drawable/ic_left" />

            <ImageButton
                android:id="@+id/next_puzzle"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:background="@color/button_background_color"
                android:contentDescription="@string/show_next_puzzle"
                android:scaleType="centerInside"
                android:src="@drawable/ic_right" />
        </LinearLayout>

        <!-- Solved indicator -->
        <LinearLayout
            android:id="@+id/hint_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/solved"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/is_solved"
                android:src="@drawable/ic_solved"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Reload button: bottom-start of panel -->
        <ImageButton
            android:id="@+id/puzzle_reload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            android:background="@color/button_background_color"
            android:contentDescription="@string/reload"
            android:scaleType="centerInside"
            android:src="@drawable/ic_reload"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Hint button: bottom-end of panel -->
        <ImageButton
            android:id="@+id/puzzle_hint"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            android:background="@color/button_background_color"
            android:contentDescription="@string/hint"
            android:scaleType="centerInside"
            android:src="@drawable/ic_hint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
